zeno 1;
project 1 task_intent_reference;
namespace 2 task_intents;
type 100 state State;
type 101 command Event;
type 102 context Context;
type 103 destination Receiver;
type 104 payload Applied;
type 105 int Phase in 0..=3;
type 106 int Packet in 0..=2;
type 107 int Capability in 0..=1;
type 108 int Action in 0..=11;
type 109 int Unit in 0..=0;
field 110 100 phase1 105;
field 111 100 phase2 105;
field 112 100 packet 106;
field 113 100 capability 107;
field 120 101 action 108;
field 130 102 unit 109;
field 140 104 slot 106;
reason 200 unavailable precedence 0;
reason 201 invalid_receipt_capability precedence 1;
reason 202 payload_conflict precedence 2;
reason 203 capacity precedence 3;
channel 300 receiver_applied destination 103 payload 104;
component 400 protocol {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  outbox outbox.300;
  budget steps 65536;
}
merge [400];
law 500 valid_pre on any = (pre.100.112 == 0 -> pre.100.113 == 0) && (pre.100.112 == 1 -> (pre.100.110 == 1 || pre.100.110 == 2)) && (pre.100.112 == 2 -> (pre.100.111 == 1 || pre.100.111 == 2)) && (pre.100.113 == 1 -> ((pre.100.112 == 1 && pre.100.110 == 2) || (pre.100.112 == 2 && pre.100.111 == 2)));
law 501 valid_post on commit, genesis = (post.100.112 == 0 -> post.100.113 == 0) && (post.100.112 == 1 -> (post.100.110 == 1 || post.100.110 == 2)) && (post.100.112 == 2 -> (post.100.111 == 1 || post.100.111 == 2)) && (post.100.113 == 1 -> ((post.100.112 == 1 && post.100.110 == 2) || (post.100.112 == 2 && post.100.111 == 2)));
law 502 admitted_event on commit = (command.101.120 == 0 && pre.100.110 == 0) || (command.101.120 == 1 && pre.100.111 == 0) || (command.101.120 == 2 && pre.100.112 == 0 && (pre.100.110 == 1 || pre.100.110 == 2)) || (command.101.120 == 3 && pre.100.112 == 0 && (pre.100.111 == 1 || pre.100.111 == 2)) || (command.101.120 == 4 && pre.100.112 != 0) || (command.101.120 == 5 && pre.100.113 == 1) || command.101.120 == 6 || command.101.120 == 7;
law 503 phase1_successor on commit = post.100.110 == choose(command.101.120 == 0, 1, choose(command.101.120 == 4 && pre.100.112 == 1, 2, choose(command.101.120 == 5 && pre.100.112 == 1, 3, pre.100.110)));
law 504 phase2_successor on commit = post.100.111 == choose(command.101.120 == 1, 1, choose(command.101.120 == 4 && pre.100.112 == 2, 2, choose(command.101.120 == 5 && pre.100.112 == 2, 3, pre.100.111)));
law 505 packet_successor on commit = post.100.112 == choose(command.101.120 == 2, 1, choose(command.101.120 == 3, 2, choose(command.101.120 == 5 || command.101.120 == 6 || command.101.120 == 7, 0, pre.100.112)));
law 506 capability_successor on commit = post.100.113 == choose(command.101.120 == 4, 1, choose(command.101.120 == 2 || command.101.120 == 3 || command.101.120 == 5 || command.101.120 == 6 || command.101.120 == 7, 0, pre.100.113));
law 510 exact_application_event on commit = outbox.104 == choose(command.101.120 == 4 && ((pre.100.112 == 1 && pre.100.110 == 1) || (pre.100.112 == 2 && pre.100.111 == 1)), 1, 0) && outbox.104.140 == choose(command.101.120 == 4 && ((pre.100.112 == 1 && pre.100.110 == 1) || (pre.100.112 == 2 && pre.100.111 == 1)), pre.100.112, 0);
law 511 exact_application_destination on commit = outbox.104 == choose(command.101.120 == 4 && ((pre.100.112 == 1 && pre.100.110 == 1) || (pre.100.112 == 2 && pre.100.111 == 1)), 1, 0);
