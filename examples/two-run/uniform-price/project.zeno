zeno 1;
project 1 uniform_price;
namespace 2 core;
type 100 state State;
type 101 command Command;
type 102 context Context;
type 105 int Price in 1..=2;
type 106 int Payment in 0..=2;
type 107 int Bit in 0..=1;
field 110 100 price 105;
field 111 100 alice_paid 106;
field 112 100 bob_paid 106;
field 113 100 alice_filled 107;
field 114 100 bob_filled 107;
field 120 101 user 107;
field 121 101 amount 107;
component 400 decision {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  budget steps 256;
}
merge [400];
law 500 bounded on commit, genesis = post.100.110 >= 0;
// This synthesized batch settlement uses a fixed price and separate user settlement slots.
law 501 batch_settlement_matches_price on any = post.100.111 == choose(command.101.120 == 0, command.101.121 * pre.100.110, pre.100.111) && post.100.112 == choose(command.101.120 == 1, command.101.121 * pre.100.110, pre.100.112) && post.100.113 == choose(command.101.120 == 0, command.101.121, pre.100.113) && post.100.114 == choose(command.101.120 == 1, command.101.121, pre.100.114);
