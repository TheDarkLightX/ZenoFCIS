zeno 1;
project 1 withdrawal_window_fair;
namespace 2 permissions;
type 100 state Roles;
type 101 command Request;
type 102 context Session;
type 105 int Parent in 0..=3;
type 106 index Role of 110;
type 107 int Grant in 0..=1;
// Withdrawals with a fair operator: the operator may pause, but reopens the window now and then
// States: 0 open, 1 withdrawn, 2 paused
// Guarantee (goal): the user has withdrawn, infinitely often.
// Assumption (fair): the window is open, infinitely often.
// from_<state> holds when the controller wins from that state under the assumption.
// Who moves: 0 = controller, 1 = environment.
const table 110 mover 107 size 3 [0,1,1];
const table 800 next0 105 size 3 [2,1,3];
const table 801 next1 105 size 3 [3,3,1];
const table 840 goal 107 size 3 [0,1,0];
const table 860 fair 107 size 3 [1,0,0];
table 210 100 grants 107 size 3;
field 120 101 role 106;
variant 130 102 Session none;
reason 200 permission_required precedence 0;
component 400 inheritance {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  budget steps 4096;
}
merge [400];
// w(k,j,l,i)[s]: the environment can escape stratum (k,j,l) of the fair winning region through assumption i.
derived table 1000 w1_0_1_0[s] in table 110 rounds 3 {
  when true then ((goal[s] == 0 || ((mover[s] == 0 && forall t in table 110 { !(next0[s] == t + 1 || next1[s] == t + 1) || false }) || (mover[s] == 1 && (!(next0[s] != 0 || next1[s] != 0) || exists t in table 110 { (next0[s] == t + 1 || next1[s] == t + 1) && false })))) && ((mover[s] == 0 && forall t in table 110 { !(next0[s] == t + 1 || next1[s] == t + 1) || true }) || (mover[s] == 1 && (!(next0[s] != 0 || next1[s] != 0) || exists t in table 110 { (next0[s] == t + 1 || next1[s] == t + 1) && true })))) && (fair[s] == 1 || ((mover[s] == 0 && forall t in table 110 { !(next0[s] == t + 1 || next1[s] == t + 1) || w1_0_1_0[t] }) || (mover[s] == 1 && (!(next0[s] != 0 || next1[s] != 0) || exists t in table 110 { (next0[s] == t + 1 || next1[s] == t + 1) && w1_0_1_0[t] }))));
  default false;
};
