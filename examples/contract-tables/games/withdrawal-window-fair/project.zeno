law 500 domains on commit, genesis = forall s in table 110 { post.100.210[s] >= 0 && post.100.210[s] <= 1 };
law 600 from_open on commit = win[0];
law 601 from_withdrawn on commit = win[1];
law 602 from_paused on commit = win[2];
