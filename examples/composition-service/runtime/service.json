          "current_generation": "keydir.generation",
          "reader_generation": "choose(op == 6, keydir.device_2_generation, keydir.device_1_generation)",
          "reader_status": "choose(op == 6, keydir.device_2, keydir.device_1)",
          "slot": "target"
        },
        "invariant": "(slot_1_status == 140 -> slot_1_generation == 0) && (slot_1_status != 140 -> slot_1_generation >= 1) && (slot_2_status == 140 -> slot_2_generation == 0) && (slot_2_status != 140 -> slot_2_generation >= 1)",
        "name": "mailbox",
        "owns": [
          "mailbox.slot_1_status",
          "mailbox.slot_1_generation",
          "mailbox.slot_2_status",
          "mailbox.slot_2_generation"
        ],
        "participates": "true",
        "path": "mailbox-keyed",
        "policy_sha256": "645d334d9e358bcb37da876fea6ab52f670f39b48b89b7844b5768093c875aad",
        "program_sha256": "6cd25598df1ba36c4f3a9b5de53558f294a4e6df3297908e382cafb6fb457f3e",
        "project_sha256": "fbb8b8cf178d0bab7a9d6170a31fc93d4449c2dae60d03cfa449566f08099355"
      }
    ],
    "couplings": [
      {
        "invariant": "mailbox.slot_1_generation <= keydir.generation && mailbox.slot_2_generation <= keydir.generation",
        "members": [
          "keydir",
          "mailbox"
        ],
        "name": "mail_uses_issued_keys"
      },
      {
        "invariant": "(keydir.device_1 == 145 -> keydir.device_1_generation < keydir.generation) && (keydir.device_2 == 145 -> keydir.device_2_generation < keydir.generation)",
        "members": [
          "keydir",
          "mailbox"
        ],
        "name": "revoked_device_lacks_new_keys"
