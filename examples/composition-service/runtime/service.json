        "domain": {
          "kind": "int",
          "max": 7,
          "min": 0
        },
        "name": "op"
      },
      {
        "domain": {
          "kind": "int",
          "max": 2,
          "min": 1
        },
        "name": "target"
      }
    ],
    "schema": "zeno-fcis/checked-composition/3"
  },
  "schemas": [
    "01fb5616c5d70dd8d19f7d8a1397743fc5ade640b659492a08cee0702ba4198b",
    "6cf605302186f1dc79e54a1794c354aa7ea766020100f118d7af1ff029b4d860"
  ],
  "laws": [
    {
      "name": "read-selected-device",
      "formula": "accepted && (request.op == 5 || request.op == 6) -> choose(request.op == 6, pre.keydir.device_2, pre.keydir.device_1) == 144 && choose(request.target == 1, pre.mailbox.slot_1_generation, pre.mailbox.slot_2_generation) <= choose(request.op == 6, pre.keydir.device_2_generation, pre.keydir.device_1_generation) && choose(request.target == 1, post.mailbox.slot_1_status, post.mailbox.slot_2_status) == 142",
