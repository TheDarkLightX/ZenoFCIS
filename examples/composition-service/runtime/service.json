          "context": "choose(op == 3, 131, 130)",
          "device": "target"
        },
        "invariant": "(device_1 == 143 -> device_1_generation == 0) && (device_1 == 144 -> device_1_generation == generation) && (device_1 == 145 -> device_1_generation < generation) && (device_2 == 143 -> device_2_generation == 0) && (device_2 == 144 -> device_2_generation == generation) && (device_2 == 145 -> device_2_generation < generation) && (generation == 0 -> device_1 == 143 && device_2 == 143)",
        "name": "keydir",
        "owns": [
          "keydir.device_1",
          "keydir.device_2",
          "keydir.generation",
          "keydir.device_1_generation",
          "keydir.device_2_generation",
          "keydir.anchor_pending"
        ],
        "participates": "true",
        "path": "keydir",
        "policy_sha256": "6bcc51fb4d5a65b84504b16b56b72a1e8448b6475d9196419a23fbec799163f9",
