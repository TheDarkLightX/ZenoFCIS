zeno 1;
project 1 task_status;
namespace 2 tasks;
// One bounded, non-value-moving task. Only explicit authenticated adapter
// observations can resolve its outcome. A transport acknowledgement is not success.
type 100 state Task;
type 101 command TaskCommand;
type 102 context Role;
type 103 destination Receiver;
type 104 payload TaskIntent;
type 105 int Attempt in 0..=2;
type 106 int Artifact in 1..=2;
type 107 data TaskStatus;
type 108 data TaskAction;
field 110 100 status 107;
field 111 100 attempt 105;
field 120 101 action 108;
field 121 101 observed_attempt 105;
field 122 101 artifact 106;
field 140 104 attempt 105;
variant 150 107 Idle none;
variant 151 107 Pending none;
variant 152 107 Running none;
variant 153 107 Succeeded none;
variant 154 107 Failed none;
variant 155 107 Unknown none;
variant 156 107 Cancelled none;
variant 160 108 Request none;
variant 161 108 Start none;
variant 162 108 Succeed none;
variant 163 108 Fail none;
variant 164 108 Timeout none;
variant 165 108 Cancel none;
variant 166 108 Retry none;
variant 170 102 Operator none;
variant 171 102 Adapter none;
variant 172 102 Observer none;
reason 200 wrong_role precedence 0;
reason 201 wrong_artifact precedence 1;
reason 202 stale_attempt precedence 2;
reason 203 wrong_stage precedence 3;
reason 204 retry_exhausted precedence 4;
channel 300 local_task destination 103 payload 104;
component 400 task {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  outbox outbox.300;
  budget steps 64;
}
merge [400];
law 500 attempt_matches_lifecycle on commit, genesis = (post.100.110 == 150 && post.100.111 == 0) || (post.100.110 != 150 && post.100.111 > 0);
law 501 authorized_and_correlated on commit = !(((command.101.120 == 160 || command.101.120 == 165 || command.101.120 == 166) && context.102 != 170) || ((command.101.120 >= 161 && command.101.120 <= 164) && context.102 != 171)) && command.101.122 == 1 && command.101.121 == pre.100.111;
law 502 eligible_stage on commit = !((command.101.120 == 160 && pre.100.110 != 150) || (command.101.120 == 161 && pre.100.110 != 151) || ((command.101.120 == 162 || command.101.120 == 163) && pre.100.110 != 152 && pre.100.110 != 155) || (command.101.120 == 164 && pre.100.110 != 152) || (command.101.120 == 165 && pre.100.110 != 151) || (command.101.120 == 166 && pre.100.110 != 154)) && !(command.101.120 == 166 && pre.100.111 >= 2);
law 503 exact_successor on commit = (command.101.120 == 160 -> post.100.110 == 151 && post.100.111 == 1) && (command.101.120 == 161 -> post.100.110 == 152 && post.100.111 == pre.100.111) && (command.101.120 == 162 -> post.100.110 == 153 && post.100.111 == pre.100.111) && (command.101.120 == 163 -> post.100.110 == 154 && post.100.111 == pre.100.111) && (command.101.120 == 164 -> post.100.110 == 155 && post.100.111 == pre.100.111) && (command.101.120 == 165 -> post.100.110 == 156 && post.100.111 == pre.100.111) && (command.101.120 == 166 -> post.100.110 == 151 && post.100.111 == pre.100.111 + 1);
law 504 exact_refusal_wrong_role on reject:200 = (((command.101.120 == 160 || command.101.120 == 165 || command.101.120 == 166) && context.102 != 170) || ((command.101.120 >= 161 && command.101.120 <= 164) && context.102 != 171));
law 505 exact_refusal_wrong_artifact on reject:201 = !(((command.101.120 == 160 || command.101.120 == 165 || command.101.120 == 166) && context.102 != 170) || ((command.101.120 >= 161 && command.101.120 <= 164) && context.102 != 171)) && (command.101.122 != 1);
law 506 exact_refusal_stale_attempt on reject:202 = !(((command.101.120 == 160 || command.101.120 == 165 || command.101.120 == 166) && context.102 != 170) || ((command.101.120 >= 161 && command.101.120 <= 164) && context.102 != 171)) && !(command.101.122 != 1) && (command.101.121 != pre.100.111);
law 507 exact_refusal_wrong_stage on reject:203 = !(((command.101.120 == 160 || command.101.120 == 165 || command.101.120 == 166) && context.102 != 170) || ((command.101.120 >= 161 && command.101.120 <= 164) && context.102 != 171)) && !(command.101.122 != 1) && !(command.101.121 != pre.100.111) && ((command.101.120 == 160 && pre.100.110 != 150) || (command.101.120 == 161 && pre.100.110 != 151) || ((command.101.120 == 162 || command.101.120 == 163) && pre.100.110 != 152 && pre.100.110 != 155) || (command.101.120 == 164 && pre.100.110 != 152) || (command.101.120 == 165 && pre.100.110 != 151) || (command.101.120 == 166 && pre.100.110 != 154));
law 508 exact_refusal_retry_exhausted on reject:204 = !(((command.101.120 == 160 || command.101.120 == 165 || command.101.120 == 166) && context.102 != 170) || ((command.101.120 >= 161 && command.101.120 <= 164) && context.102 != 171)) && !(command.101.122 != 1) && !(command.101.121 != pre.100.111) && !((command.101.120 == 160 && pre.100.110 != 150) || (command.101.120 == 161 && pre.100.110 != 151) || ((command.101.120 == 162 || command.101.120 == 163) && pre.100.110 != 152 && pre.100.110 != 155) || (command.101.120 == 164 && pre.100.110 != 152) || (command.101.120 == 165 && pre.100.110 != 151) || (command.101.120 == 166 && pre.100.110 != 154)) && (command.101.120 == 166 && pre.100.111 >= 2);
law 510 only_start_emits on commit = (command.101.120 == 161 -> outbox.104 == 1 && outbox.104.140 == pre.100.111) && (command.101.120 != 161 -> outbox.104 == 0);
law 511 fixed_receiver on commit = command.101.120 == 161 -> outbox.104 == 1;
