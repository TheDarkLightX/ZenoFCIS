zeno 1;
project 1 library_loans;
namespace 2 library;
// Three copies of one book and three members. Each copy records its holder:
// 0 means on the shelf, 1..3 is the member who has it. One holder per copy
// means a copy cannot be lent twice; the rules also refuse to try.
type 100 state Loans;
type 101 command LoanCommand;
type 102 context Desk;
type 105 int Holder in 0..=3;
type 106 int CopyNumber in 1..=3;
type 107 int MemberNumber in 1..=3;
type 108 data LoanAction;
field 110 100 copy_1 105;
field 111 100 copy_2 105;
field 112 100 copy_3 105;
field 120 101 action 108;
field 121 101 copy 106;
field 122 101 member 107;
variant 150 108 Borrow none;
variant 151 108 Return none;
variant 130 102 Librarian none;
variant 131 102 Visitor none;
reason 200 librarian_required precedence 0;
reason 201 copy_on_loan precedence 1;
reason 202 loan_limit precedence 2;
reason 203 not_holder precedence 3;
component 400 loans {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  budget steps 64;
}
merge [400];
// With three copies, "at most two per member" means no member holds all three.
law 500 at_most_two_per_member on commit, genesis = post.100.110 == 0 || post.100.110 != post.100.111 || post.100.110 != post.100.112;
law 501 librarian_only on commit = context.102 == 130;
// Only the chosen copy changes hands; the other two keep their holders.
law 502 other_copies_unchanged on commit = (command.101.121 == 1 -> post.100.111 == pre.100.111 && post.100.112 == pre.100.112) && (command.101.121 == 2 -> post.100.110 == pre.100.110 && post.100.112 == pre.100.112) && (command.101.121 == 3 -> post.100.110 == pre.100.110 && post.100.111 == pre.100.111);
// A borrow takes a copy from the shelf to the member; a return takes it from
// that member back to the shelf. So no copy on loan is lent again.
law 503 exact_loan on commit = (command.101.120 == 150 && command.101.121 == 1 -> pre.100.110 == 0 && post.100.110 == command.101.122) && (command.101.120 == 150 && command.101.121 == 2 -> pre.100.111 == 0 && post.100.111 == command.101.122) && (command.101.120 == 150 && command.101.121 == 3 -> pre.100.112 == 0 && post.100.112 == command.101.122) && (command.101.120 == 151 && command.101.121 == 1 -> pre.100.110 == command.101.122 && post.100.110 == 0) && (command.101.120 == 151 && command.101.121 == 2 -> pre.100.111 == command.101.122 && post.100.111 == 0) && (command.101.120 == 151 && command.101.121 == 3 -> pre.100.112 == command.101.122 && post.100.112 == 0);
// Each possible rejection reason requires exactly its first matching guard.
// Together these four laws forbid rejecting an eligible borrow or return.
law 504 librarian_reason_requires_a_visitor on reject:200 = context.102 != 130;
law 505 on_loan_reason_requires_an_occupied_copy on reject:201 = context.102 == 130 && command.101.120 == 150 && ((command.101.121 == 1 && pre.100.110 != 0) || (command.101.121 == 2 && pre.100.111 != 0) || (command.101.121 == 3 && pre.100.112 != 0));
law 506 limit_reason_requires_a_free_copy_and_two_loans on reject:202 = context.102 == 130 && command.101.120 == 150 && ((command.101.121 == 1 && pre.100.110 == 0) || (command.101.121 == 2 && pre.100.111 == 0) || (command.101.121 == 3 && pre.100.112 == 0)) && ((pre.100.110 == command.101.122 && pre.100.111 == command.101.122) || (pre.100.110 == command.101.122 && pre.100.112 == command.101.122) || (pre.100.111 == command.101.122 && pre.100.112 == command.101.122));
law 507 holder_reason_requires_a_mismatched_return on reject:203 = context.102 == 130 && command.101.120 == 151 && ((command.101.121 == 1 && pre.100.110 != command.101.122) || (command.101.121 == 2 && pre.100.111 != command.101.122) || (command.101.121 == 3 && pre.100.112 != command.101.122));
