[package]
name = "compliance-gateway"
version = "0.0.0"
edition = "2024"
rust-version = "1.97.1"
publish = false

# The emitted application is independent of any enclosing workspace.
[workspace]

# The SQLite shell is optional: the core builds without it, for a host or for
# wasm32-unknown-unknown.
[features]
default = ["sqlite"]
sqlite = ["dep:zeno-fcis-shell-sqlite"]

[dependencies]
zeno-fcis-authority = "=1.1.0"
zeno-fcis-catalog = "=1.1.0"
zeno-fcis-codec = "=1.1.0"
zeno-fcis-compose = "=1.1.0"
zeno-fcis-core = "=1.1.0"
zeno-fcis-crypto = { version = "=1.1.0", features = ["rustcrypto"] }
zeno-fcis-evidence = "=1.1.0"
zeno-fcis-laws = "=1.1.0"
zeno-fcis-patch = "=1.1.0"
zeno-fcis-plan = "=1.1.0"
zeno-fcis-project = "=1.1.0"
zeno-fcis-schema = "=1.1.0"
zeno-fcis-shell = "=1.1.0"
zeno-fcis-shell-sqlite = { version = "=1.1.0", optional = true }
zeno-fcis-spec = "=1.1.0"
zeno-fcis-transition = "=1.1.0"
zeno-fcis-value = "=1.1.0"

[build-dependencies]
zeno-fcis-bootstrap = "=1.1.0"
zeno-fcis-catalog = "=1.1.0"
zeno-fcis-codec = "=1.1.0"
zeno-fcis-crypto = { version = "=1.1.0", features = ["rustcrypto"] }
zeno-fcis-laws = "=1.1.0"
zeno-fcis-project = "=1.1.0"
zeno-fcis-schema = "=1.1.0"
zeno-fcis-spec = "=1.1.0"

# The demonstration needs the shell; the library alone builds without it.
[[bin]]
name = "compliance-gateway"
path = "src/main.rs"
required-features = ["sqlite"]

[profile.dev]
debug = 0
incremental = false
