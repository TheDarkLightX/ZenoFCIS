{
  "schema": "zeno-fcis/run-properties/1",
  "observer": {
    "closed_count": {
      "min": 0,
      "max": 2,
      "initial": 0,
      "update": "choose(outbox.300.141 == 176 || outbox.300.141 == 177 || outbox.300.141 == 178, choose(before.closed_count == 0, 1, 2), before.closed_count)"
    },
    "refunded": {
      "min": 0,
      "max": 1,
      "initial": 0,
      "update": "choose(outbox.300.141 == 176 || outbox.300.141 == 177, 1, before.refunded)"
    }
  },
  "properties": [
    {
      "kind": "predicate",
      "name": "terminal_payment_request_at_most_once",
      "formula": "observer.closed_count <= 1"
    },
    {
      "kind": "predicate",
      "name": "no_capture_release_or_shipping_after_refund",
      "formula": "before.refunded == 1 -> outbox.300 == 0 && outbox.301 == 0"
    },
    {
      "kind": "at_most_once",
      "name": "shipping_requested_at_most_once",
      "channel": 301
    }
  ]
}
