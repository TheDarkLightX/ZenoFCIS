zeno 1;
project 1 agent_treasury_guard;
namespace 2 treasury;
// One treasury holding a quote asset and a base asset. An AI agent proposes
// swaps; its proposal is only a command, and this decision is the guard. Time,
// the oracle price, and the agent's model identity arrive in the context. An
// accepted swap leaves through the outbox as a SwapIntent-shaped request for
// ZenoDEX, whose settlement or failure comes back as a command.
type 100 state Treasury;
type 101 command TreasuryCommand;
type 102 context GuardContext;
type 103 destination DexDestination;
type 104 payload SwapRequest;
type 105 int QuoteUnits;
type 106 int BaseUnits;
type 107 int SpentUnits;
type 108 int Tick;
type 109 data PendingSwap;
type 110 data Direction;
type 111 int HeldAmount;
type 112 int TradeAmount;
type 113 int MinOut;
type 114 int AmountOut;
type 115 data TreasuryAction;
type 116 data Caller;
type 117 int Price;
type 118 data ModelId;
type 119 int Deadline;
type 120 data Asset;
field 130 100 quote 105;
field 131 100 base 106;
field 132 100 spent_today 107;
field 133 100 last_seen 108;
field 134 100 pending 109;
field 135 100 pending_amount 111;
field 136 100 pending_min_out 113;
field 140 101 action 115;
field 141 101 direction 110;
field 142 101 amount 112;
field 143 101 min_out 113;
field 144 101 intent 108;
field 145 101 amount_out 114;
field 150 102 caller 116;
field 151 102 now 108;
field 152 102 price 117;
field 153 102 price_time 108;
field 154 102 model 118;
field 160 104 intent_number 108;
field 161 104 asset_in 120;
field 162 104 asset_out 120;
field 163 104 amount_in 112;
field 164 104 min_amount_out 113;
field 165 104 deadline 119;
variant 170 109 NoSwap none;
variant 171 109 PendingBuy none;
variant 172 109 PendingSell none;
variant 173 110 BuyBase none;
variant 174 110 SellBase none;
variant 175 115 ProposeSwap none;
variant 176 115 SwapSettled none;
variant 177 115 SwapFailed none;
variant 178 116 Agent none;
variant 179 116 Dex none;
variant 180 118 TreasuryAgentV2 none;
variant 181 118 TreasuryAgentV1 none;
variant 182 118 UnlistedModel none;
variant 183 120 Quote none;
variant 184 120 Base none;
reason 200 wrong_caller precedence 0;
reason 201 clock_not_advanced precedence 1;
reason 202 unapproved_model precedence 2;
reason 203 stale_price precedence 3;
reason 204 swap_outstanding precedence 4;
reason 205 no_swap_outstanding precedence 5;
reason 206 stale_callback precedence 6;
reason 207 short_settlement precedence 7;
reason 208 over_trade_cap precedence 8;
reason 209 over_daily_budget precedence 9;
reason 210 slippage_too_wide precedence 10;
reason 211 below_reserve precedence 11;
reason 212 swap_failed precedence 12;
channel 300 swap_request destination 103 payload 104;
component 400 treasury {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  outbox outbox.300;
  budget steps 64;
}
merge [400];
// The quote balance keeps the reserve of 2, the base balance never goes
// negative, a day's committed value stays between 0 and the budget of 4, and
// the swap amounts are held only while a swap is pending: at least 1 unit,
// with a minimum that is never negative. Claim 600 states the same invariant
// over the treasury before a decision.
law 500 treasury_within_limits on commit, genesis = post.100.130 >= 2 && post.100.131 >= 0 && post.100.132 >= 0 && post.100.132 <= 4 && (post.100.134 == 170 -> post.100.135 == 0 && post.100.136 == 0) && (post.100.134 != 170 -> post.100.135 >= 1 && post.100.136 >= 0);
// Every committed decision carries a later tick than the last and records it,
// so intent numbers, which are proposal ticks, are unique.
law 501 commits_advance_the_clock on commit = context.102.151 > pre.100.133 && post.100.133 == context.102.151;
// `spent_today` counts the day's committed quote value: it restarts on a new
// day (a day is 4 ticks), a buy adds its amount, a sell adds its amount at the
// oracle price, and a settlement or failure adds nothing.
law 502 spent_today_counts_the_day on commit = (div_floor(context.102.151, 4) > div_floor(pre.100.133, 4) -> (command.101.140 != 175 -> post.100.132 == 0) && (command.101.140 == 175 && command.101.141 == 173 -> post.100.132 == command.101.142) && (command.101.140 == 175 && command.101.141 == 174 -> post.100.132 == command.101.142 * context.102.152)) && (div_floor(context.102.151, 4) == div_floor(pre.100.133, 4) -> (command.101.140 != 175 -> post.100.132 == pre.100.132) && (command.101.140 == 175 && command.101.141 == 173 -> post.100.132 == pre.100.132 + command.101.142) && (command.101.140 == 175 && command.101.141 == 174 -> post.100.132 == pre.100.132 + command.101.142 * context.102.152));
// An accepted proposal came from the agent under an approved model with a
// price at most 1 tick old and no swap outstanding, and leaves one
// outstanding; an accepted settlement came from the DEX, names the
// outstanding intent, and leaves none; a failure is never accepted.
law 503 proposal_and_settlement_authority on accept = (command.101.140 == 175 -> context.102.150 == 178 && context.102.154 == 180 && context.102.153 <= context.102.151 && context.102.151 - context.102.153 <= 1 && pre.100.134 == 170 && post.100.134 != 170) && (command.101.140 == 176 -> context.102.150 == 179 && pre.100.134 != 170 && command.101.144 == pre.100.133 && post.100.134 == 170) && command.101.140 != 177;
// A settlement delivers at least the outstanding minimum, credits exactly
// `amount_out` to the bought asset, changes no other balance, and clears the
// swap.
law 504 settlement_credits_exactly on accept = command.101.140 == 176 -> command.101.145 >= pre.100.136 && post.100.134 == 170 && post.100.135 == 0 && post.100.136 == 0 && (pre.100.134 == 171 -> post.100.131 == pre.100.131 + command.101.145 && post.100.130 == pre.100.130) && (pre.100.134 == 172 -> post.100.130 == pre.100.130 + command.101.145 && post.100.131 == pre.100.131);
// A proposal sells at least 1 unit, debits exactly its amount from the asset
// it sells, leaves at least the reserve of 2 quote or a non-negative base,
// and changes no other balance.
law 505 proposal_debits_the_sold_asset on accept = command.101.140 == 175 -> command.101.142 >= 1 && (command.101.141 == 173 -> post.100.130 + command.101.142 == pre.100.130 && post.100.130 >= 2 && post.100.131 == pre.100.131) && (command.101.141 == 174 -> post.100.131 + command.101.142 == pre.100.131 && post.100.131 >= 0 && post.100.130 == pre.100.130);
// The swap the treasury records is the swap the agent proposed: the same
// direction, amount, and minimum output that the queued request carries.
law 506 proposal_records_the_swap on accept = command.101.140 == 175 -> post.100.135 == command.101.142 && post.100.136 == command.101.143 && (command.101.141 == 173 -> post.100.134 == 171) && (command.101.141 == 174 -> post.100.134 == 172);
// The swap the treasury records is valued at a positive oracle price, commits
// at most 3 of quote value, fits the day's budget of 4 together with what the
// day already committed (law 502 counts it), and its minimum output keeps at
// least three quarters of the oracle value, rounded up so that rounding never
// favors the agent. Law 506 ties the recorded swap to the proposal.
law 507 proposal_within_cap_budget_and_slippage on accept = command.101.140 == 175 -> context.102.152 >= 1 && post.100.132 <= 4 && (command.101.141 == 173 -> post.100.135 <= 3 && post.100.136 >= div_ceil(post.100.135 * 3, 4 * context.102.152)) && (command.101.141 == 174 -> post.100.135 * context.102.152 <= 3 && post.100.136 >= div_ceil(post.100.135 * context.102.152 * 3, 4));
// A failure reported by the DEX for the outstanding intent refunds exactly
// the held amount to the asset it was taken from and clears the swap. The
// budget is not restored.
law 508 failure_refunds_the_swap on failure = command.101.140 == 177 && context.102.150 == 179 && pre.100.134 != 170 && command.101.144 == pre.100.133 && post.100.134 == 170 && post.100.135 == 0 && post.100.136 == 0 && (pre.100.134 == 171 -> post.100.130 == pre.100.130 + pre.100.135 && post.100.131 == pre.100.131) && (pre.100.134 == 172 -> post.100.131 == pre.100.131 + pre.100.135 && post.100.130 == pre.100.130);
// The claims below are checked by `zeno-fcis prove` (see the README). Each is
// an induction step over the laws named in its groups: laws 501 and 502 are
// enforced on every committing decision, 503 to 507 on accepts, and 508 on
// committed failures. Claim 600 states law 500's invariant over the treasury
// before a decision. Claim 601 states the budget's part on its own, from the
// clock, the day accounting, the proposal's debit and limits, and the refund.
// tests/claims.rs checks the base case, the observer, and the manifest.
claim 600 treasury_stays_within_limits all inductive assume [501, 502] accept [503, 504, 505, 506, 507] failure [508] = pre.100.130 >= 2 && pre.100.131 >= 0 && pre.100.132 >= 0 && pre.100.132 <= 4 && (pre.100.134 == 170 -> pre.100.135 == 0 && pre.100.136 == 0) && (pre.100.134 != 170 -> pre.100.135 >= 1 && pre.100.136 >= 0);
claim 601 budget_never_exceeded all inductive assume [501, 502] accept [505, 507] failure [508] = pre.100.132 >= 0 && pre.100.132 <= 4;
