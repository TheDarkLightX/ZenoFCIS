zeno 1;
project 1 bounded_counter;
namespace 2 core;
type 100 state Counter;
type 101 command Change;
type 102 context Operator;
type 105 int Units in 0..=${C};
type 107 data Action;
type 108 bool Authorized;
field 110 100 value 105;
field 120 101 action 107;
field 130 102 authorized 108;
variant 150 107 Inc none;
variant 151 107 Dec none;
reason 200 not_authorized precedence 0;
reason 201 at_capacity precedence 1;
reason 202 at_zero precedence 2;
component 400 counter {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  budget steps 64;
}
merge [400];
law 500 bounded on commit, genesis = 0 <= post.100.110 && post.100.110 <= ${C};
law 501 authorized_bounded_result on accept = context.102.130 == 1 && 0 <= post.100.110 && post.100.110 <= ${C};
law 502 exact_movement on accept = (command.101.120 == 150 -> post.100.110 == pre.100.110 + 1) && (command.101.120 == 151 -> post.100.110 + 1 == pre.100.110);
