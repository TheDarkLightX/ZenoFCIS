{
  "schema": "zeno-fcis/template-declarative-policy/2",
  "template": "bounded-counter-${INSTANCE}",
  "roots": {
    "state": 100,
    "command": 101,
    "context": 102
  },
  "leaf_bindings": {
    "108": [
      "Bool"
    ]
  },
  "variables": {
    "value": "pre.100.110",
    "action": "command.101.120",
    "authorized": "context.102.130"
  },
  "cases": [
    {
      "when": "!authorized",
      "class": "Reject",
      "reason": 200,
      "post": {},
      "outbox": []
    },
    {
      "when": "action == 150 && value == ${C}",
      "class": "Reject",
      "reason": 201,
      "post": {},
      "outbox": []
    },
    {
      "when": "action == 151 && value == 0",
      "class": "Reject",
      "reason": 202,
      "post": {},
      "outbox": []
    },
    {
      "when": "action == 150",
      "class": "Accept",
      "reason": null,
      "post": {
        "110": "value + 1"
      },
      "outbox": []
    },
    {
      "when": "true",
      "class": "Accept",
      "reason": null,
      "post": {
        "110": "value - 1"
      },
      "outbox": []
    }
  ],
  "genesis": {
    "110": 0
  },
  "law_kinds": {
    "500": "StateInvariant",
    "501": "DebitCreditEffectEquality",
    "502": "DebitCreditEffectEquality"
  }
}
