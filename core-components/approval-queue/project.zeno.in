zeno 1;
project 1 approval_queue;
namespace 2 core;
type 100 state Request;
type 101 command Operation;
type 102 context Principal;
type 105 data Phase;
type 106 data Action;
type 107 int PrincipalId in 0..=2;
type 108 bool Flag;
field 110 100 phase 105;
field 111 100 vote0 108;
field 112 100 vote1 108;
field 113 100 vote2 108;
field 120 101 action 106;
field 130 102 principal 107;
field 131 102 authorized 108;
variant 150 105 Empty none;
variant 151 105 Pending none;
variant 152 105 Executed none;
variant 160 106 Enqueue none;
variant 161 106 Vote none;
variant 162 106 Execute none;
reason 200 invalid_state precedence 0;
reason 201 not_authorized precedence 1;
reason 202 wrong_phase precedence 2;
reason 203 duplicate_vote precedence 3;
reason 204 quorum_missing precedence 4;
component 400 queue {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  budget steps 64;
}
merge [400];
law 500 approved_execution on commit, genesis = (post.100.110 == 150 -> post.100.111 + post.100.112 + post.100.113 == 0) && (post.100.110 == 152 -> post.100.111 + post.100.112 + post.100.113 >= ${K});
law 501 lifecycle on accept = context.102.131 == 1 && (command.101.120 == 160 -> pre.100.110 == 150 && post.100.110 == 151 && post.100.111 + post.100.112 + post.100.113 == 0) && (command.101.120 == 161 -> pre.100.110 == 151 && post.100.110 == 151) && (command.101.120 == 162 -> pre.100.110 == 151 && post.100.110 == 152);
law 502 votes_conserved on accept = (command.101.120 == 162 -> post.100.111 == pre.100.111 && post.100.112 == pre.100.112 && post.100.113 == pre.100.113) && (command.101.120 == 161 -> post.100.111 + post.100.112 + post.100.113 == pre.100.111 + pre.100.112 + pre.100.113 + 1 && (context.102.130 == 0 -> post.100.111 == 1 && post.100.112 == pre.100.112 && post.100.113 == pre.100.113) && (context.102.130 == 1 -> post.100.112 == 1 && post.100.111 == pre.100.111 && post.100.113 == pre.100.113) && (context.102.130 == 2 -> post.100.113 == 1 && post.100.111 == pre.100.111 && post.100.112 == pre.100.112));
// Independent complete relation; ordered guards exclude earlier reasons.
law 520 reason_200 on reject:200 = (true) && ((pre.100.110 == 150 && pre.100.111 + pre.100.112 + pre.100.113 != 0) || (pre.100.110 == 152 && pre.100.111 + pre.100.112 + pre.100.113 < ${K}));
law 521 reason_201 on reject:201 = ((true) && !((pre.100.110 == 150 && pre.100.111 + pre.100.112 + pre.100.113 != 0) || (pre.100.110 == 152 && pre.100.111 + pre.100.112 + pre.100.113 < ${K}))) && (context.102.131 == 0);
law 522 reason_202 on reject:202 = (((true) && !((pre.100.110 == 150 && pre.100.111 + pre.100.112 + pre.100.113 != 0) || (pre.100.110 == 152 && pre.100.111 + pre.100.112 + pre.100.113 < ${K}))) && !(context.102.131 == 0)) && (pre.100.110 == 152 || (command.101.120 == 160 && pre.100.110 != 150) || (command.101.120 != 160 && pre.100.110 != 151));
law 523 reason_203 on reject:203 = ((((true) && !((pre.100.110 == 150 && pre.100.111 + pre.100.112 + pre.100.113 != 0) || (pre.100.110 == 152 && pre.100.111 + pre.100.112 + pre.100.113 < ${K}))) && !(context.102.131 == 0)) && !(pre.100.110 == 152 || (command.101.120 == 160 && pre.100.110 != 150) || (command.101.120 != 160 && pre.100.110 != 151))) && (command.101.120 == 161 && ((context.102.130 == 0 && pre.100.111 == 1) || (context.102.130 == 1 && pre.100.112 == 1) || (context.102.130 == 2 && pre.100.113 == 1)));
law 524 reason_204 on reject:204 = (((((true) && !((pre.100.110 == 150 && pre.100.111 + pre.100.112 + pre.100.113 != 0) || (pre.100.110 == 152 && pre.100.111 + pre.100.112 + pre.100.113 < ${K}))) && !(context.102.131 == 0)) && !(pre.100.110 == 152 || (command.101.120 == 160 && pre.100.110 != 150) || (command.101.120 != 160 && pre.100.110 != 151))) && !(command.101.120 == 161 && ((context.102.130 == 0 && pre.100.111 == 1) || (context.102.130 == 1 && pre.100.112 == 1) || (context.102.130 == 2 && pre.100.113 == 1)))) && (command.101.120 == 162 && pre.100.111 + pre.100.112 + pre.100.113 < ${K});
law 540 legitimate_acceptance on reject = !((((((true) && !((pre.100.110 == 150 && pre.100.111 + pre.100.112 + pre.100.113 != 0) || (pre.100.110 == 152 && pre.100.111 + pre.100.112 + pre.100.113 < ${K}))) && !(context.102.131 == 0)) && !(pre.100.110 == 152 || (command.101.120 == 160 && pre.100.110 != 150) || (command.101.120 != 160 && pre.100.110 != 151))) && !(command.101.120 == 161 && ((context.102.130 == 0 && pre.100.111 == 1) || (context.102.130 == 1 && pre.100.112 == 1) || (context.102.130 == 2 && pre.100.113 == 1)))) && !(command.101.120 == 162 && pre.100.111 + pre.100.112 + pre.100.113 < ${K}));
law 541 acceptance_eligibility on accept = (((((true) && !((pre.100.110 == 150 && pre.100.111 + pre.100.112 + pre.100.113 != 0) || (pre.100.110 == 152 && pre.100.111 + pre.100.112 + pre.100.113 < ${K}))) && !(context.102.131 == 0)) && !(pre.100.110 == 152 || (command.101.120 == 160 && pre.100.110 != 150) || (command.101.120 != 160 && pre.100.110 != 151))) && !(command.101.120 == 161 && ((context.102.130 == 0 && pre.100.111 == 1) || (context.102.130 == 1 && pre.100.112 == 1) || (context.102.130 == 2 && pre.100.113 == 1)))) && !(command.101.120 == 162 && pre.100.111 + pre.100.112 + pre.100.113 < ${K});
law 542 no_committed_failure on failure = false;
