zeno 1;
project 1 versioned_register;
namespace 2 core;
type 100 state Register;
type 101 command Write;
type 102 context Operator;
type 105 int Units in 0..=${C};
type 108 bool Authorized;
field 110 100 value 105;
field 111 100 version 105;
field 120 101 expected_version 105;
field 121 101 new_value 105;
field 130 102 authorized 108;
reason 200 not_authorized precedence 0;
reason 201 version_mismatch precedence 1;
reason 202 at_max_version precedence 2;
component 400 register {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  budget steps 128;
}
merge [400];
law 500 bounded on commit, genesis = 0 <= post.100.110 && post.100.110 <= ${C} && 0 <= post.100.111 && post.100.111 <= ${C};
law 501 authorized_bounded_result on accept = context.102.130 == 1 && 0 <= post.100.110 && post.100.110 <= ${C} && 0 <= post.100.111 && post.100.111 <= ${C};
law 502 exact_write on accept = command.101.120 == pre.100.111 && post.100.110 == command.101.121 && post.100.111 == pre.100.111 + 1;
