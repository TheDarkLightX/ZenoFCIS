      "post": {},
      "outbox": []
    },
    {
      "when": "version == ${C}",
      "class": "Reject",
      "reason": 202,
      "post": {},
      "outbox": []
    },
    {
      "when": "true",
      "class": "Accept",
      "reason": null,
