zeno 1;
project 1 finite_phase_machine;
namespace 2 core;
type 100 state PhaseMachine;
type 101 command Step;
type 102 context Operator;
type 105 int Units in 0..=${C};
type 106 bool Flag;
type 108 bool Authorized;
field 110 100 phase 105;
field 120 101 reset 106;
field 130 102 authorized 108;
reason 200 not_authorized precedence 0;
reason 201 premature_reset precedence 1;
reason 202 at_final_phase precedence 2;
component 400 phase_machine {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  budget steps 128;
}
merge [400];
law 500 bounded on commit, genesis = 0 <= post.100.110 && post.100.110 <= ${C};
law 501 authorized_bounded_result on accept = context.102.130 == 1 && 0 <= post.100.110 && post.100.110 <= ${C};
law 502 exact_transition on accept = (command.101.120 == 1 -> (pre.100.110 == ${C} && post.100.110 == 0)) && (command.101.120 == 0 -> post.100.110 == pre.100.110 + 1);
