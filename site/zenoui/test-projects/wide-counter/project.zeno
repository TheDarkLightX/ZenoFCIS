zeno 1;
project 1 wide_counter;
namespace 2 counter;
type 100 state Counter;
type 101 command Action;
type 102 context Permission;
type 105 int Credits;
field 110 100 balance 105;
variant 120 101 Increase none;
variant 121 101 Decrease none;
variant 122 101 Hold none;
variant 130 102 Operator none;
variant 131 102 Visitor none;
reason 200 permission_required precedence 0;
reason 201 at_bound precedence 1;
component 400 counter {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  budget steps 64;
}
merge [400];
law 500 within_bounds on commit, genesis = post.100.110 >= 9007199254740993 && post.100.110 <= 9007199254740995;
law 501 permission_checked on commit = context.102 == 130;
law 502 exact_change on commit = (command.101 == 120 -> post.100.110 == pre.100.110 + 1) && (command.101 == 121 -> post.100.110 == pre.100.110 - 1) && (command.101 == 122 -> post.100.110 == pre.100.110);
