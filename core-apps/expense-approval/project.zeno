zeno 1;
project 1 expense_approval;
namespace 2 core_apps;
type 100 state Expense;
type 101 command ExpenseCommand;
type 102 context Principal;
type 103 destination Bank;
type 104 payload Payment;
type 105 int Units in 0..=7;
type 106 int Phase in 0..=2;
type 107 int Key in 0..=1;
type 108 bool Flag;
type 109 int PrincipalId in 0..=2;
type 115 data Action;
field 110 100 remaining 105;
field 111 100 phase 106;
field 112 100 vote0 108;
field 113 100 vote1 108;
field 114 100 vote2 108;
field 120 101 action 115;
field 121 101 requested_amount 105;
field 122 101 request_key 107;
field 130 102 principal 109;
field 131 102 authorized 108;
field 140 104 payment_amount 105;
field 141 104 payment_key 107;
variant 160 115 Enqueue none;
variant 161 115 Vote none;
variant 162 115 Execute none;
reason 204 invalid_coupled_state precedence 0;
reason 200 not_authorized precedence 1;
reason 205 changed_subject precedence 2;
reason 202 wrong_phase precedence 3;
reason 201 duplicate_vote precedence 4;
reason 203 missing_quorum precedence 5;
channel 300 payment destination 103 payload 104;
// One physical component publishes the complete application atomically.
// composition.json pins queue/budget owners and a derived read-only memo view.
component 400 expense {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  outbox outbox.300;
  budget steps 64;
}
merge [400];
law 500 approval_and_budget_agree on commit, genesis = (post.100.111 == 0 -> post.100.110 == 7 && post.100.112 + post.100.113 + post.100.114 == 0) && (post.100.111 == 1 -> post.100.110 == 7) && (post.100.111 == 2 -> post.100.110 == 4 && post.100.112 + post.100.113 + post.100.114 >= 2);
law 501 exact_authorized_subject on accept = context.102.131 == 1 && command.101.121 == 3 && command.101.122 == 1;
law 502 distinct_vote_and_lifecycle on accept = (command.101.120 == 160 -> pre.100.111 == 0 && post.100.111 == 1 && post.100.112 + post.100.113 + post.100.114 == 0) && (command.101.120 == 161 -> pre.100.111 == 1 && post.100.111 == 1 && post.100.112 + post.100.113 + post.100.114 == pre.100.112 + pre.100.113 + pre.100.114 + 1 && (context.102.130 == 0 -> pre.100.112 == 0 && post.100.112 == 1 && post.100.113 == pre.100.113 && post.100.114 == pre.100.114) && (context.102.130 == 1 -> pre.100.113 == 0 && post.100.113 == 1 && post.100.112 == pre.100.112 && post.100.114 == pre.100.114) && (context.102.130 == 2 -> pre.100.114 == 0 && post.100.114 == 1 && post.100.112 == pre.100.112 && post.100.113 == pre.100.113)) && (command.101.120 == 162 -> (pre.100.111 == 1 || pre.100.111 == 2) && pre.100.112 + pre.100.113 + pre.100.114 >= 2 && post.100.111 == 2 && post.100.112 == pre.100.112 && post.100.113 == pre.100.113 && post.100.114 == pre.100.114);
law 503 payment_equals_once_spend on commit = outbox.104 <= 1 && (pre.100.111 == 1 && post.100.111 == 2 -> post.100.110 + 3 == pre.100.110 && outbox.104 == 1 && outbox.104.140 == 3 && outbox.104.141 == 1) && (!(pre.100.111 == 1 && post.100.111 == 2) -> post.100.110 == pre.100.110 && outbox.104 == 0 && outbox.104.140 == 0 && outbox.104.141 == 0);
