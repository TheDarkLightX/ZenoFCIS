zeno 1;
project 1 api_quota;
namespace 2 core_apps;
type 100 state ClientQuota;
type 101 command Request;
type 102 context SuppliedContext;
type 103 destination Service;
type 104 payload ServiceIntent;
type 105 int Epoch in 0..=6;
type 106 int Used in 0..=3;
type 107 int Tag in 0..=2;
type 108 bool Flag;
field 110 100 window_start 105;
field 111 100 used 106;
field 112 100 seen 108;
field 113 100 last_key 107;
field 114 100 last_payload 107;
field 120 101 request_key 107;
field 121 101 request_payload 107;
field 130 102 epoch 105;
field 131 102 authorized 108;
field 140 104 intent_epoch 105;
field 141 104 intent_key 107;
field 142 104 intent_payload 107;
reason 204 invalid_coupled_state precedence 0;
reason 200 not_authorized precedence 1;
reason 201 conflicting_retry precedence 2;
reason 202 stale_epoch precedence 3;
reason 203 quota_exhausted precedence 4;
channel 300 service_intent destination 103 payload 104;
// One physical component publishes the complete application atomically.
// composition.json pins quota and memo ownership, views and occurrences.
component 400 api_quota {
  owns 100;
  reads pre.100;
  writes post.100;
  contexts context.102;
  outbox outbox.300;
  budget steps 64;
}
merge [400];
law 500 quota_and_memo_agree on commit, genesis = (post.100.112 == 0 && post.100.110 == 0 && post.100.111 == 0 && post.100.113 == 0 && post.100.114 == 0) || (post.100.112 == 1 && post.100.111 >= 1 && post.100.111 <= 3);
law 501 authorized_request_recorded on accept = context.102.131 == 1 && post.100.112 == 1 && post.100.113 == command.101.120 && post.100.114 == command.101.121;
law 502 exactly_once_charge on accept = (pre.100.112 == 1 && pre.100.113 == command.101.120 && pre.100.114 == command.101.121 -> post.100.110 == pre.100.110 && post.100.111 == pre.100.111) && (!(pre.100.112 == 1 && pre.100.113 == command.101.120 && pre.100.114 == command.101.121) -> context.102.130 >= pre.100.110 && (context.102.130 > pre.100.110 -> post.100.110 == context.102.130 && post.100.111 == 1) && (context.102.130 == pre.100.110 -> post.100.110 == pre.100.110 && post.100.111 == pre.100.111 + 1));
law 503 intent_equals_charge on commit = outbox.104 <= 1 && ((post.100.110 != pre.100.110 || post.100.111 != pre.100.111) -> outbox.104 == 1 && outbox.104.140 == context.102.130 && outbox.104.141 == post.100.113 && outbox.104.142 == post.100.114) && ((post.100.110 == pre.100.110 && post.100.111 == pre.100.111) -> outbox.104 == 0 && outbox.104.140 == 0 && outbox.104.141 == 0 && outbox.104.142 == 0);
