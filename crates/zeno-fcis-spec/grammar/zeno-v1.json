      64
    ],
    "scalar": "i128; direct -2^127 is the minimum, other negation is Sub(0,operand)",
    "quantity": "only int; unit number atom must be 1; scale e0..e38; normalized by Quantity",
    "source_bytes": 1048576,
    "source_tokens": 262144,
    "formula_depth": 256,
    "operator_chain": 255,
    "note": "These typed constraints are checked by lowering; they are not established by structural certificate membership alone."
  },
