    {
      "when": "(action == 120 && count >= 3) || (action == 121 && failures >= 3)",
      "class": "Reject",
      "reason": 201,
      "post": {},
      "outbox": []
    },
    {
      "when": "action != 121",
      "class": "Accept",
      "reason": null,
      "post": {
        "110": "count + 1",
        "111": "failures"
      },
      "outbox": [
        {
          "ordinal": 0,
          "channel": 300,
          "destination": "local-observer",
          "payload": {
            "112": "count + 1",
            "113": "failures"
          },
          "idempotency_ordinal": 0
        }
      ]
    },
    {
      "when": "true",
      "class": "CommittedFailure",
      "reason": 202,
      "post": {
        "110": "count",
        "111": "failures + 1"
      },
      "outbox": [
        {
          "ordinal": 0,
          "channel": 300,
          "destination": "local-observer",
          "payload": {
            "112": "count",
            "113": "failures + 1"
          },
          "idempotency_ordinal": 0
        }
      ]
    }
  ],
  "genesis": {
