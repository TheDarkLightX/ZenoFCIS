    "context": 102
  },
  "leaf_bindings": {
    "102": [
      "Bool"
    ],
    "103": [
      "Text",
      1,
      32
    ],
    "105": [
      "I128",
      0,
      3
    ]
  },
  "variables": {
    "count": "pre.100.110",
    "failures": "pre.100.111",
    "action": "command.101",
    "allowed": "context.102"
