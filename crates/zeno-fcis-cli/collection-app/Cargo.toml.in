[package]
name = "{package}"
version = "0.0.0"
edition = "2024"
rust-version = "1.97.1"
publish = false
default-run = "app-server"

[workspace]

[features]
default = ["sqlite"]
sqlite = []

[lib]
name = "application"

[dependencies]
zeno-fcis-codec = "={version}"
zeno-fcis-contract = "={version}"
zeno-fcis-ingress = "={version}"
zeno-fcis-shell-sqlite = "={version}"
zeno-fcis-synthesis = { version = "={version}", default-features = false }
zeno-fcis-value = "={version}"
serde_json = "=1.0.151"
tokio = { version = "=1.53.2", default-features = false, features = ["rt", "net", "time"] }

[[bin]]
name = "app-server"
path = "src/main.rs"

[profile.dev]
debug = 0
incremental = false

[profile.dev.package.zeno-fcis-synthesis]
opt-level = 3
