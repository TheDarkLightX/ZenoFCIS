  budget steps 64;
}
merge [400];
law 500 bounded_state = post.100.110 >= 0 && post.100.110 <= 3;
law 501 accepted_batch = context.102 == 1 && pre.100.110 + command.101.120 >= 0 && pre.100.110 + command.101.120 <= 3 && pre.100.110 + command.101.120 + command.101.121 >= 0 && pre.100.110 + command.101.120 + command.101.121 <= 3 && post.100.110 == pre.100.110 + command.101.120 + command.101.121 + command.101.122;
