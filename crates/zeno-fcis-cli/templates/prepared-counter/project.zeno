zeno 1;
project 1 prepared_counter;
namespace 2 core;
type 100 state CounterState;
type 101 command CounterCommand;
type 102 context CounterContext;
type 103 destination NotificationDestination;
type 104 payload Notification;
type 105 int CounterValue;
type 106 int CounterDelta;
field 110 100 count 105;
field 112 104 notified_count 105;
field 120 101 first 106;
field 121 101 second 106;
field 122 101 third 106;
reason 200 denied precedence 0;
reason 201 capacity precedence 1;
channel 300 notify destination 103 payload 104;
component 400 counter {
  owns 100;
  reads pre.100;
  writes post.100;
