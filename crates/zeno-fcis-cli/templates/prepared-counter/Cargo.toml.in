[package]
name = "prepared-counter"
version = "0.0.0"
edition = "2024"
rust-version = "1.97.1"
publish = false

# The emitted application is independent of any enclosing workspace.
[workspace]

# The SQLite shell is optional: the core builds without it, for a host or for
# wasm32-unknown-unknown.
[features]
default = ["sqlite"]
sqlite = ["dep:zeno-fcis-shell-sqlite"]

[dependencies]
zeno-fcis-authority = "=2.6.0"
zeno-fcis-catalog = "=2.6.0"
zeno-fcis-codec = "=2.6.0"
zeno-fcis-compose = "=2.6.0"
zeno-fcis-core = "=2.6.0"
zeno-fcis-crypto = { version = "=2.6.0", features = ["rustcrypto"] }
zeno-fcis-evidence = "=2.6.0"
zeno-fcis-laws = "=2.6.0"
zeno-fcis-patch = "=2.6.0"
zeno-fcis-plan = "=2.6.0"
zeno-fcis-project = "=2.6.0"
zeno-fcis-schema = "=2.6.0"
zeno-fcis-shell = "=2.6.0"
zeno-fcis-shell-sqlite = { version = "=2.6.0", optional = true }
zeno-fcis-spec = "=2.6.0"
zeno-fcis-synthesis = "=2.6.0"
zeno-fcis-transition = "=2.6.0"
zeno-fcis-value = "=2.6.0"

[dev-dependencies]
# Tests opt in to interruptions; normal application builds expose no crash API.
zeno-fcis-shell-sqlite = { version = "=2.6.0", features = ["crash-injection"] }

[build-dependencies]
zeno-fcis-bootstrap = "=2.6.0"
zeno-fcis-catalog = "=2.6.0"
zeno-fcis-codec = "=2.6.0"
zeno-fcis-crypto = { version = "=2.6.0", features = ["rustcrypto"] }
zeno-fcis-laws = "=2.6.0"
zeno-fcis-project = "=2.6.0"
zeno-fcis-schema = "=2.6.0"
zeno-fcis-spec = "=2.6.0"

# The demonstration needs the shell; the library alone builds without it.
[[bin]]
name = "prepared-counter"
path = "src/main.rs"
required-features = ["sqlite"]

[profile.dev]
debug = 0
incremental = false

# Every program comparison a store upgrade or open makes runs in the
# library evaluator; optimising that one crate keeps debug builds usable.
# Overflow checks and debug assertions stay on, as in every dev build.
[profile.dev.package.zeno-fcis-synthesis]
opt-level = 3
