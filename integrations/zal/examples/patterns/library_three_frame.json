    "law": 502,
    "name": "other_copies_unchanged",
    "when": "commit",
    "body": "(command.101.121 == 1 -> post.100.111 == pre.100.111 && post.100.112 == pre.100.112) && (command.101.121 == 2 -> post.100.110 == pre.100.110 && post.100.112 == pre.100.112) && (command.101.121 == 3 -> post.100.110 == pre.100.110 && post.100.111 == pre.100.111)"
  },
