  "definitions": [
    {
      "name": "OnlyChosenChanges",
      "params": [
        {
          "name": "t",
          "domain": "T"
        }
      ],
      "body": "forall c in C: c != chosen(t) => holder'(t, c) = holder(t, c)",
      "clause": "{0} changes only the chosen copy"
    }
  ],
  "formula": "forall t in T: Committed(t) => (forall c in C: c != chosen(t) => holder'(t, c) = holder(t, c))",
