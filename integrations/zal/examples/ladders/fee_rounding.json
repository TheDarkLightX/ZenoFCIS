{
  "theory": "steps-over-integers",
  "id": "fee_rounding",
  "kind": "law",
  "authority": {
    "status": "DECIDED",
    "source": "LADDERS.md §6; Spot owner policy fixed fee constants. Presentation remains proposed."
  },
  "scope": "Accepted Spot SwapExactIn or SwapExactOut steps. Integer input-asset atoms; B=10000, fee rate=30, protocol rate=2000. Fixture membership and native arithmetic refinement are separate.",
