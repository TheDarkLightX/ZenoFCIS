      "member": "step",
      "plural": "steps",
      "noun": "steps"
    }
  },
  "symbols": {
    "S": {
      "kind": "predicate",
      "arity": 1,
      "args": [
        "T"
      ],
      "clause": "{0} is an accepted swap",
      "noun": "accepted swap"
    },
    "a": {
      "kind": "function",
      "arity": 1,
      "args": [
        "T"
      ],
      "noun": "gross input",
      "state": false
    },
    "fee": {
      "kind": "function",
      "arity": 1,
      "args": [
        "T"
      ],
      "noun": "total fee",
      "state": false
    },
    "protocol": {
      "kind": "function",
      "arity": 1,
      "args": [
