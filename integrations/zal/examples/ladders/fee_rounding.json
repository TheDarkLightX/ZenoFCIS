      "noun": "protocol share",
      "state": false
    },
    "net": {
      "kind": "function",
      "arity": 1,
      "args": [
        "T"
      ],
      "noun": "pricing input",
      "state": false
    },
    "lp": {
      "kind": "function",
      "arity": 1,
      "args": [
        "T"
      ],
      "noun": "LP fee",
      "state": false
    }
  },
  "definitions": [
    {
      "name": "SpotFeeSplit",
      "params": [
        {
          "name": "t",
          "domain": "T"
        }
      ],
      "body": "fee(t) = ceil(a(t)*30 / 10000) and protocol(t) = floor(fee(t)*2000 / 10000) and net(t) = a(t)-fee(t) and lp(t) = fee(t)-protocol(t)",
      "clause": "{0} uses the Spot fee split"
    }
  ],
  "formula": "forall t in T: S(t) => (fee(t) = ceil(a(t)*30 / 10000) and protocol(t) = floor(fee(t)*2000 / 10000) and net(t) = a(t)-fee(t) and lp(t) = fee(t)-protocol(t))",
