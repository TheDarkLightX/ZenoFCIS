zal 3;
machine batch_notification;
states low, high;
events apply;
context authorized;
input first in -1..=1;
input second in -1..=1;
input third in -1..=1;
var count in 0..=3 initially 0;
initial low;
step atomic; frame control_and_variables;
default reject capacity unchanged;
rule denied_low: low + apply [!authorized] -> reject denied unchanged;
rule apply_low_low: low + apply [authorized & (count + first >= 0 & count + first <= 3 & count + first + second >= 0 & count + first + second <= 3 & count + first + second + third >= 0 & count + first + second + third <= 3) & count + first + second + third <= 1] -> accept low, count = count + first + second + third;
rule apply_high_low: low + apply [authorized & (count + first >= 0 & count + first <= 3 & count + first + second >= 0 & count + first + second <= 3 & count + first + second + third >= 0 & count + first + second + third <= 3) & count + first + second + third >= 2] -> accept high, count = count + first + second + third;
rule denied_high: high + apply [!authorized] -> reject denied unchanged;
rule apply_low_high: high + apply [authorized & (count + first >= 0 & count + first <= 3 & count + first + second >= 0 & count + first + second <= 3 & count + first + second + third >= 0 & count + first + second + third <= 3) & count + first + second + third <= 1] -> accept low, count = count + first + second + third;
rule apply_high_high: high + apply [authorized & (count + first >= 0 & count + first <= 3 & count + first + second >= 0 & count + first + second <= 3 & count + first + second + third >= 0 & count + first + second + third <= 3) & count + first + second + third >= 2] -> accept high, count = count + first + second + third;
invariant category_matches_count: ((state == low => count <= 1) & (state == high => count >= 2));
require accepted_only_if_authorized: accepted => authorized;
require accepted_applies_all_deltas: accepted => count' == count + first + second + third;
